# Copy this file to .env.local and fill in real values.
# .env.local is already git-ignored — never commit real secrets.

# Password for the admin dashboard at /admin/login
ADMIN_PASSWORD=change-me-to-something-only-you-know

# Random secret used to sign the admin session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
